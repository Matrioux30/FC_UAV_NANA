{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Simulasi Hover (C++)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/quadcopter_pid.exe",
            "args": ["hover"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb-multiarch.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe build active file"
        },
