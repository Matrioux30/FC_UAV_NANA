{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe build active file",
            "command": "g++",
            "args": [
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/third_party/eigen",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/quadcopter.cpp",
                "${workspaceFolder}/src/pid_controller.cpp",
                "${workspaceFolder}/src/cascade_controller.cpp",
                "${workspaceFolder}/src/scenario.cpp",
                "${workspaceFolder}/src/csv_writer.cpp",
                "-O2",
                "-g",
                "-o",
                "${workspaceFolder}/quadcopter_pid.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Antigravity."
        }
    ]
}
